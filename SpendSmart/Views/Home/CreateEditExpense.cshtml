@{
    ViewData["Title"] = "Create / Edit";
}

@model SpendSmart.Models.Expence

<div class="text-center">
    <h1 class="display-4">Create or edit an expense</h1>
</div>

<form>
    <label>Id</label>
    <input class="form-control" type="number" placeholder="0" asp-for="Id"/>
    <label>Value</label>
    <input class="form-control" type="number" placeholder="0" asp-for="Value" />
    <label>Description</label>
    <input class="form-control" type="text" placeholder="Description" asp-for="Description" />
</form>
